{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SiteProof AWS-B Lite serverless monitor CANDIDATE (Scheduler -> Lambda -> DynamoDB -> SNS direct notification + aggregate heartbeat metric). OFFLINE CANDIDATE / AWS LIVE NOT VERIFIED / AWS-B LIVE NO-GO. AWS has not accepted this template.",
  "Metadata": {
    "ReviewStatus": "OFFLINE_CANDIDATE_AWS_LIVE_NOT_VERIFIED",
    "SafetyGate": "AWS-B LIVE NO-GO until separate USER approval",
    "Arming": "Deploying this stack does not start monitoring. The schedule defaults to DISABLED and the handler refuses every event until an operator creates the CONTROL item (see docs/aws_portfolio/RUNBOOK_AWS_B.md).",
    "Egress": "The function is not attached to a VPC. Destination control is an application-level allowlist with a pinned connection; no network-layer egress enforcement is claimed.",
    "Isolation": "Does not import, reference or modify the AWS-A public_web stack or the ops_guard stack. The alert topic ARN is a plain String parameter.",
    "OpenItems": "AWS acceptance, actual Scheduler timestamp, reserved concurrency quota, DynamoDB LeadingKeys behaviour, SNS Publish under the Permissions Boundary, EMF heartbeat extraction and the aggregate heartbeat alarm (infra/aws_b/health.json) remain LIVE-unverified. Runtime is pinned to python3.13.",
    "Notification": "The probe Lambda publishes state changes directly to the existing alert topic (sns:Publish on that one ARN). There are no per-page alarms; a missing run is detected by the shared heartbeat alarm in health.json. Publish success does not prove mail delivery and delivery is not exactly-once."
  },
  "Parameters": {
    "TargetId": {
      "Type": "String",
      "Default": "preview",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "Description": "Logical name of the single owner-operated target."
    },
    "TargetHostname": {
      "Type": "String",
      "AllowedPattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
      "Description": "Exact DNS hostname of the owner-operated HTTPS target. Not a URL, wildcard or IP literal (the last label must be alphabetic). The handler re-validates it."
    },
    "TargetPath": {
      "Type": "String",
      "Default": "/home/index.html",
      "AllowedPattern": "^/[A-Za-z0-9._~/-]{0,255}$",
      "Description": "Absolute path requested with GET. No query string."
    },
    "PolicyVersion": {
      "Type": "String",
      "Default": "p1",
      "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "ExecutionGeneration": {
      "Type": "Number",
      "Default": 1,
      "MinValue": 1,
      "MaxValue": 1000000,
      "Description": "Generation embedded in every scheduled event. Must equal the CONTROL item's generation; a stop increments the CONTROL item so queued events stop matching."
    },
    "AbsoluteEndAt": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "Description": "UTC instant after which the schedule stops and the handler refuses to probe. Not a billing cap."
    },
    "ScheduleExpression": {
      "Type": "String",
      "Default": "rate(6 hours)",
      "AllowedValues": [
        "rate(5 minutes)",
        "rate(10 minutes)",
        "rate(15 minutes)",
        "rate(30 minutes)",
        "rate(1 hour)",
        "rate(6 hours)",
        "rate(12 hours)"
      ]
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ],
      "Description": "ENABLED is configuration, never USER authorization."
    },
    "AlertTopicArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws[a-z-]*:sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]{1,256}$",
      "Description": "Existing SNS topic (ops_guard output). The probe publishes state changes to it directly; its policy must also allow cloudwatch.amazonaws.com for the heartbeat alarm."
    },
    "CodeBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "CodeKey": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9._/-]{1,512}$"
    },
    "CodeObjectVersion": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9._-]{1,1024}$",
      "Description": "Pins the exact reviewed package version."
    },
    "LambdaRuntime": {
      "Type": "String",
      "Default": "python3.13",
      "Description": "Pinned Python 3.13 managed runtime; validate-template and LIVE import remain approval-gated.",
      "AllowedValues": [
        "python3.13"
      ]
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 14,
      "AllowedValues": [
        7,
        14,
        30
      ]
    },
    "UseReservedConcurrency": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "true pins concurrency to 1. Accounts with a low concurrency quota may be unable to reserve; false removes this guard and must be recorded as a deviation."
    },
    "MonitorGroup": {
      "Type": "String",
      "Default": "siteproof-b",
      "AllowedPattern": "^[A-Za-z0-9._-]{1,64}$",
      "Description": "Dimension of the ProbeCompleted heartbeat metric. Every page of one deployment uses the same value; health.json watches it."
    }
  },
  "Conditions": {
    "ReserveConcurrency": {
      "Fn::Equals": [
        {
          "Ref": "UseReservedConcurrency"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "ProbeTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at",
          "Enabled": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "SiteProof"
          },
          {
            "Key": "Component",
            "Value": "AWS-B"
          }
        ]
      }
    },
    "ProbeLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-probe"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "ProbeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ProbeLeastPrivilege",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ClaimAndRecordOwnTargetOnly",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:UpdateItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProbeTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        {
                          "Fn::Sub": "CONTROL#${TargetId}"
                        },
                        {
                          "Fn::Sub": "RUN#${TargetId}"
                        }
                      ]
                    }
                  }
                },
                {
                  "Sid": "WriteOwnLogStreamsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProbeLogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "PublishToAlertTopicOnly",
                  "Effect": "Allow",
                  "Action": "sns:Publish",
                  "Resource": {
                    "Ref": "AlertTopicArn"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "SiteProof"
          },
          {
            "Key": "Component",
            "Value": "AWS-B"
          }
        ]
      }
    },
    "ProbeFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "ProbeLogGroup",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-probe"
        },
        "Description": "SiteProof AWS-B Lite: one bounded HTTPS probe of a fixed owner-operated target per claimed slot, then a direct SNS notification on state change.",
        "Runtime": {
          "Ref": "LambdaRuntime"
        },
        "Architectures": [
          "arm64"
        ],
        "Handler": "src.aws_b.handler.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "ProbeRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Ref": "CodeObjectVersion"
          }
        },
        "Timeout": 20,
        "MemorySize": 256,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "ReserveConcurrency",
            1,
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Environment": {
          "Variables": {
            "TARGET_ID": {
              "Ref": "TargetId"
            },
            "TARGET_HOSTNAME": {
              "Ref": "TargetHostname"
            },
            "TARGET_PATH": {
              "Ref": "TargetPath"
            },
            "POLICY_VERSION": {
              "Ref": "PolicyVersion"
            },
            "ABSOLUTE_END_AT": {
              "Ref": "AbsoluteEndAt"
            },
            "TABLE_NAME": {
              "Ref": "ProbeTable"
            },
            "MAX_EVENT_AGE_SECONDS": "60",
            "PROBE_TIMEOUT_SECONDS": "8",
            "RECORD_TTL_DAYS": "14",
            "METRIC_NAMESPACE": "SiteProof/Monitor",
            "ALERT_TOPIC_ARN": {
              "Ref": "AlertTopicArn"
            },
            "MONITOR_GROUP": {
              "Ref": "MonitorGroup"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "SiteProof"
          },
          {
            "Key": "Component",
            "Value": "AWS-B"
          }
        ]
      }
    },
    "ProbeAsyncConfig": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "ProbeFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeProbeOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "InvokeProbeOnly",
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "ProbeFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "SiteProof"
          },
          {
            "Key": "Component",
            "Value": "AWS-B"
          }
        ]
      }
    },
    "ProbeSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "DependsOn": "ProbeAsyncConfig",
      "Properties": {
        "Description": "SiteProof AWS-B probe schedule. Bounded by EndDate; not a billing cap.",
        "ScheduleExpression": {
          "Ref": "ScheduleExpression"
        },
        "ScheduleExpressionTimezone": "UTC",
        "State": {
          "Ref": "ScheduleState"
        },
        "EndDate": {
          "Fn::Join": [
            "",
            [
              {
                "Fn::Select": [
                  0,
                  {
                    "Fn::Split": [
                      "Z",
                      {
                        "Ref": "AbsoluteEndAt"
                      }
                    ]
                  }
                ]
              },
              ".000Z"
            ]
          ]
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "ProbeFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"schema\":\"siteproof.monitor.event.v1\",\"target_id\":\"${TargetId}\",\"scheduled_time\":\"<aws.scheduler.scheduled-time>\",\"execution_generation\":${ExecutionGeneration}}"
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 0,
            "MaximumEventAgeInSeconds": 60
          }
        }
      }
    }
  },
  "Outputs": {
    "TableName": {
      "Description": "Control and run records. RETAINED on stack deletion.",
      "Value": {
        "Ref": "ProbeTable"
      }
    },
    "FunctionName": {
      "Description": "Probe function. Not an availability observation.",
      "Value": {
        "Ref": "ProbeFunction"
      }
    },
    "ScheduleName": {
      "Description": "Schedule name (default DISABLED).",
      "Value": {
        "Ref": "ProbeSchedule"
      }
    },
    "MonitorGroup": {
      "Description": "Heartbeat dimension; the aggregate alarm (health.json) must use the same value.",
      "Value": {
        "Ref": "MonitorGroup"
      }
    }
  }
}
