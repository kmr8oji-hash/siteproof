{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "NOT DEPLOYABLE UNDER THE CURRENT OPERATOR IAM (2026-11-20): the operator may only create roles named siteproof-b-*-probe-role / -scheduler-role with the AWS-B permission boundaries, and those boundaries do not allow scheduler/concurrency/alarm stop actions. A full in-AWS stopper needs a separately approved IAM change. SiteProof AWS-B in-AWS safe stop for ONE probe stack (companion stack; the probe stack is not modified). One-time Scheduler entry at StopAt invokes a stopper Lambda on its own IAM role: heartbeat alarm actions off, CONTROL disabled + generation+1, probe schedule DISABLED, probe concurrency 0, readback. Never deletes. AWS LIVE NOT VERIFIED / NO-GO until USER approval.",
 "Parameters": {
  "TargetId": {
   "Type": "String",
   "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
   "Description": "Same TargetId as the probe stack."
  },
  "ProbeStackName": {
   "Type": "String",
   "AllowedPattern": "^siteproof-b-[0-9]{8}-[0-9]{6}-[A-Za-z0-9-]{1,64}$",
   "Description": "Probe stack whose <stack>-runs / -probe / -schedule / -scheduler-role / alarms are stopped."
  },
  "StopAt": {
   "Type": "String",
   "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
   "Description": "UTC instant of the planned stop. Must not be later than the probe AbsoluteEndAt (checked by the plan generator)."
  },
  "AlertTopicArn": {
   "Type": "String",
   "AllowedPattern": "^arn:aws[a-z-]*:sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]{1,256}$",
   "Description": "Existing SNS topic of the probe stacks (stop failures are mailed there)."
  },
  "CodeBucket": {
   "Type": "String",
   "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
  },
  "CodeKey": {
   "Type": "String",
   "AllowedPattern": "^[A-Za-z0-9._/-]{1,512}$"
  },
  "CodeObjectVersion": {
   "Type": "String",
   "AllowedPattern": "^[A-Za-z0-9._-]{1,1024}$",
   "Description": "Pins the reviewed package version."
  },
  "LambdaRuntime": {
   "Type": "String",
   "Default": "python3.13",
   "AllowedValues": [
    "python3.13"
   ]
  },
  "LogRetentionDays": {
   "Type": "Number",
   "Default": 14,
   "AllowedValues": [
    7,
    14,
    30
   ]
  },
  "HeartbeatAlarmName": {
   "Type": "String",
   "Default": "",
   "AllowedPattern": "^[A-Za-z0-9_.-]{0,255}$",
   "Description": "Shared heartbeat alarm of infra/aws_b/health.json (its HeartbeatAlarmName output). Its actions are disabled at the stop. Empty = no alarm to disable. GROUP stop only (every page ends together): leave it EMPTY for a single-page stop, because the alarm is shared and disabling it would hide other pages' missing runs; lower ExpectedPages of the health stack instead."
  }
 },
 "Resources": {
  "StopperLogGroup": {
   "Type": "AWS::Logs::LogGroup",
   "Properties": {
    "LogGroupName": {
     "Fn::Sub": "/aws/lambda/${AWS::StackName}-stopper"
    },
    "RetentionInDays": {
     "Ref": "LogRetentionDays"
    }
   }
  },
  "StopperRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "lambda.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "siteproof-b-stopper",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Sid": "ControlItemOnly",
         "Effect": "Allow",
         "Action": [
          "dynamodb:GetItem",
          "dynamodb:UpdateItem"
         ],
         "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${ProbeStackName}-runs"
         },
         "Condition": {
          "ForAllValues:StringEquals": {
           "dynamodb:LeadingKeys": [
            {
             "Fn::Sub": "CONTROL#${TargetId}"
            }
           ]
          }
         }
        },
        {
         "Sid": "ProbeScheduleOnly",
         "Effect": "Allow",
         "Action": [
          "scheduler:GetSchedule",
          "scheduler:UpdateSchedule"
         ],
         "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/default/${ProbeStackName}-schedule"
         }
        },
        {
         "Sid": "KeepScheduleRole",
         "Effect": "Allow",
         "Action": "iam:PassRole",
         "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ProbeStackName}-scheduler-role"
         },
         "Condition": {
          "StringEquals": {
           "iam:PassedToService": "scheduler.amazonaws.com"
          }
         }
        },
        {
         "Sid": "ProbeConcurrencyOnly",
         "Effect": "Allow",
         "Action": [
          "lambda:GetFunctionConcurrency",
          "lambda:PutFunctionConcurrency"
         ],
         "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${ProbeStackName}-probe"
         }
        },
        {
         "Sid": "HeartbeatAlarmOnly",
         "Effect": "Allow",
         "Action": [
          "cloudwatch:DisableAlarmActions",
          "cloudwatch:DescribeAlarms"
         ],
         "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${HeartbeatAlarmName}"
         }
        },
        {
         "Sid": "OwnLogs",
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": {
          "Fn::GetAtt": [
           "StopperLogGroup",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "StopperFunction": {
   "Type": "AWS::Lambda::Function",
   "DependsOn": [
    "StopperLogGroup"
   ],
   "Properties": {
    "FunctionName": {
     "Fn::Sub": "${AWS::StackName}-stopper"
    },
    "Handler": "src.aws_b.stopper.lambda_handler",
    "Runtime": {
     "Ref": "LambdaRuntime"
    },
    "Architectures": [
     "arm64"
    ],
    "MemorySize": 128,
    "Timeout": 60,
    "ReservedConcurrentExecutions": 1,
    "Role": {
     "Fn::GetAtt": [
      "StopperRole",
      "Arn"
     ]
    },
    "Code": {
     "S3Bucket": {
      "Ref": "CodeBucket"
     },
     "S3Key": {
      "Ref": "CodeKey"
     },
     "S3ObjectVersion": {
      "Ref": "CodeObjectVersion"
     }
    },
    "Environment": {
     "Variables": {
      "TARGET_ID": {
       "Ref": "TargetId"
      },
      "TABLE_NAME": {
       "Fn::Sub": "${ProbeStackName}-runs"
      },
      "SCHEDULE_NAME": {
       "Fn::Sub": "${ProbeStackName}-schedule"
      },
      "FUNCTION_NAME": {
       "Fn::Sub": "${ProbeStackName}-probe"
      },
      "ALARM_NAMES": {
       "Ref": "HeartbeatAlarmName"
      }
     }
    }
   }
  },
  "StopperAsyncConfig": {
   "Type": "AWS::Lambda::EventInvokeConfig",
   "Properties": {
    "FunctionName": {
     "Ref": "StopperFunction"
    },
    "Qualifier": "$LATEST",
    "MaximumRetryAttempts": 2,
    "MaximumEventAgeInSeconds": 3600
   }
  },
  "StopSchedulerRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "scheduler.amazonaws.com"
       },
       "Action": "sts:AssumeRole",
       "Condition": {
        "StringEquals": {
         "aws:SourceAccount": {
          "Ref": "AWS::AccountId"
         }
        }
       }
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "invoke-stopper",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": "lambda:InvokeFunction",
         "Resource": {
          "Fn::GetAtt": [
           "StopperFunction",
           "Arn"
          ]
         }
        }
       ]
      }
     }
    ]
   }
  },
  "StopSchedule": {
   "Type": "AWS::Scheduler::Schedule",
   "Properties": {
    "Description": "SiteProof AWS-B one-time planned stop (at()). Stays as a completed schedule; the stop itself never deletes.",
    "ScheduleExpression": {
     "Fn::Join": [
      "",
      [
       "at(",
       {
        "Fn::Select": [
         0,
         {
          "Fn::Split": [
           "Z",
           {
            "Ref": "StopAt"
           }
          ]
         }
        ]
       },
       ")"
      ]
     ]
    },
    "ScheduleExpressionTimezone": "UTC",
    "State": "ENABLED",
    "FlexibleTimeWindow": {
     "Mode": "OFF"
    },
    "Target": {
     "Arn": {
      "Fn::GetAtt": [
       "StopperFunction",
       "Arn"
      ]
     },
     "RoleArn": {
      "Fn::GetAtt": [
       "StopSchedulerRole",
       "Arn"
      ]
     },
     "Input": {
      "Fn::Sub": "{\"schema\":\"siteproof.stop.event.v1\",\"target_id\":\"${TargetId}\",\"requested_at\":\"<aws.scheduler.scheduled-time>\"}"
     },
     "RetryPolicy": {
      "MaximumRetryAttempts": 5,
      "MaximumEventAgeInSeconds": 3600
     }
    }
   }
  },
  "StopperErrorAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmDescription": "SiteProof AWS-B stopper failed (error/timeout). Stop by hand: MANUAL_STOP procedure.",
    "Namespace": "AWS/Lambda",
    "MetricName": "Errors",
    "Dimensions": [
     {
      "Name": "FunctionName",
      "Value": {
       "Ref": "StopperFunction"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 300,
    "EvaluationPeriods": 1,
    "Threshold": 1,
    "ComparisonOperator": "GreaterThanOrEqualToThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Ref": "AlertTopicArn"
     }
    ]
   }
  },
  "StopIncompleteAlarm": {
   "Type": "AWS::CloudWatch::Alarm",
   "Properties": {
    "AlarmDescription": "SiteProof AWS-B stop ran but a layer did not read back as stopped.",
    "Namespace": "SiteProof/Monitor",
    "MetricName": "StopIncomplete",
    "Dimensions": [
     {
      "Name": "TargetId",
      "Value": {
       "Ref": "TargetId"
      }
     }
    ],
    "Statistic": "Sum",
    "Period": 300,
    "EvaluationPeriods": 1,
    "Threshold": 1,
    "ComparisonOperator": "GreaterThanOrEqualToThreshold",
    "TreatMissingData": "notBreaching",
    "AlarmActions": [
     {
      "Ref": "AlertTopicArn"
     }
    ]
   }
  }
 },
 "Outputs": {
  "StopperFunctionName": {
   "Value": {
    "Ref": "StopperFunction"
   }
  },
  "StopAt": {
   "Value": {
    "Ref": "StopAt"
   }
  }
 }
}
